<Window x:Class="TwistClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TwistClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!-- FIXED: Single, clean, crash-proof pack resource background layer -->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Background.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- FIXED: Added crash-proof pack mapping for the logo asset as well -->
            <Image x:Name="Logo" Width="300" Height="193" Source="pack://application:,,,/TwistLogo.png" Stretch="Uniform"/>

            <Border Width="300" Height="60" Margin="0,10,0,0" CornerRadius="12" Background="#FF171322" BorderBrush="#FF7C3AED" BorderThickness="2">
                <TextBox x:Name="USERNAME" Text="USERNAME" FontWeight="Bold" FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" Padding="10" GotFocus="USERNAME_GotFocus" LostFocus="USERNAME_LostFocus"/>
            </Border>

            <Button Content="PLAY" Click="PLAY_Click" Width="300" Height="60" Margin="0,15,0,0" Background="#FF7C3AED" Foreground="White" FontSize="20" FontWeight="Bold" Padding="10"/>
            <Button Content="OPEN MODS FOLDER" Click="OPENMODS_Click" Width="300" Height="50" Margin="0,10,0,0" Background="#FF171322" Foreground="#FF7C3AED" FontSize="14" FontWeight="Bold"/>

            <TextBlock x:Name="STATUS_TEXT" Text="Ready to Launch" Foreground="#FF7C3AED" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" Width="300"/>

            <ComboBox x:Name="VERSION" Width="300" Height="50" Margin="0,15,0,0" FontSize="18" SelectedIndex="0" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <ComboBox.Template>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="#FF171322" BorderBrush="#FF7C3AED" BorderThickness="2" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White" TextElement.FontSize="18"/>
                                    <ToggleButton Width="40" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="▼" Foreground="#FF7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                                <Border Width="300" Background="#FF171322" BorderBrush="#FF7C3AED" BorderThickness="2" CornerRadius="8">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#FF171322"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#FF7C3AED"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBoxItem Content="1.8.9"/>
                <ComboBoxItem Content="1.12.2"/>
                <ComboBoxItem Content="1.16.5"/>
                <ComboBoxItem Content="1.20.1"/>
                <ComboBoxItem Content="1.21.1"/>
            </ComboBox>
        </StackPanel>
    </Grid>
</Window>
